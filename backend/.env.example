APP_NAME="Beauty Commerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=0.1.0
STOREFRONT_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
ADMIN_INVITATION_TTL_HOURS=48
ADMIN_MFA_ENABLED=false
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
CATALOG_READ_RATE_LIMIT=120
CATALOG_WRITE_RATE_LIMIT=20

MEDIA_DRIVER=cloudinary
CLOUDINARY_URL=
CLOUDINARY_FOLDER=beauty-commerce/local
PRODUCT_IMAGE_MAX_KILOBYTES=10240
REVIEW_VIDEO_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beauty_commerce
DB_USERNAME=beauty_app
DB_PASSWORD=ReplaceWithYourStrongPassword!

# ReplaceWithYourStrongPassword!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,localhost:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@beauty-commerce.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDINARY_URL=
CLOUDINARY_UPLOAD_FOLDER=beauty-commerce/local

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


