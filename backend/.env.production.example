# Railway production variables for the Laravel backend service.
# Paste these in Railway's Variables > Raw Editor and replace every placeholder.

# Application
APP_NAME="Beauty Commerce API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_VERSION=1.0.0
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# First-party browser clients
# Sanctum cookie authentication requires the SPA and API to share the same
# top-level domain. Use custom domains such as admin.example.com/api.example.com;
# *.vercel.app and *.up.railway.app cannot share a Sanctum session cookie.
STOREFRONT_URL=https://www.example.com
ADMIN_FRONTEND_URL=https://admin.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
SANCTUM_STATEFUL_DOMAINS=www.example.com,admin.example.com
SESSION_DOMAIN=
SESSION_COOKIE=beauty_commerce_session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none
SESSION_PARTITIONED_COOKIE=true
ADMIN_INVITATION_TTL_HOURS=48

# Railway MySQL service references. Rename "MySQL" if your Railway service has
# a different name; Railway's autocomplete can insert the correct references.
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Database-backed defaults require no additional service. The bundled
# Supervisor queue worker processes database jobs in the web container.
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
CATALOG_READ_RATE_LIMIT=120
CATALOG_WRITE_RATE_LIMIT=20

# Optional Railway Redis upgrade. If enabled, replace the three values above
# with CACHE_STORE=redis, QUEUE_CONNECTION=redis, SESSION_DRIVER=redis.
# REDIS_CLIENT=phpredis
# REDIS_URL=${{Redis.REDIS_URL}}

# Cloudinary media storage
MEDIA_DRIVER=cloudinary
CLOUDINARY_URL=
CLOUDINARY_FOLDER=beauty-commerce/production
PRODUCT_IMAGE_MAX_KILOBYTES=10240

# Transactional mail (required for real admin invitation/reset emails)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Railway captures stdout/stderr. Do not use file-based production logs.
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=stderr
LOG_LEVEL=info
